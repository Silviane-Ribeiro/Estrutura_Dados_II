#O usuário cadastra exatamente cinco produtos e depois o programa segue uma sequência fixa: listar, calcular total, buscar e mostrar o mais caro.
#Exemplo sequencial com cinco produtos, método valor_estoque() e max(..., key=lambda...);
from dataclasses import dataclass

# Representa a entidade Produto e seus atributos.
@dataclass
class Produto:
    codigo: int
    nome: str
    preco: float
    quantidade: int

# Calcula o valor total deste produto existente no estoque:
    # preço unitário multiplicado pela quantidade.
    def valor_estoque(self) -> float:
        return self.preco * self.quantidade

# Lista responsável por armazenar os objetos Produto cadastrados.
produtos = []

# Cadastro dos cinco produtos
for i in range(5):

    print(f"\nProduto {i + 1}")

    codigo = int(input("Código: "))
    nome = input("Nome: ")
    preco = float(input("Preço: "))
    quantidade = int(input("Quantidade: "))


    # Cria um novo objeto Produto com os dados informados.
    produto = Produto(
        codigo=codigo,
        nome=nome,
        preco=preco,
        quantidade=quantidade
    )

    produtos.append(produto)

# Lista os produtos
print("\n===== ESTOQUE =====")

# Variável acumuladora utilizada para somar
# o valor de todos os produtos existentes no estoque.
valor_total = 0.0

# Percorre todos os objetos Produto armazenados na lista.
for produto in produtos:

# Calcula o valor em estoque do produto atual
# utilizando o método definido na classe.
    valor = produto.valor_estoque()

    print(f"\nCódigo: {produto.codigo}")
    print(f"Produto: {produto.nome}")
    print(f"Preço: R$ {produto.preco:.2f}")
    print(f"Quantidade: {produto.quantidade}")
    print(f"Valor em estoque: R$ {valor:.2f}")

 # Acumula o valor deste produto no valor total do estoque.
    valor_total += valor

# Exibe o valor total
print(
    f"\nValor total do estoque: R$ {valor_total:.2f}"
)

# Busca um produto pelo código
codigo_busca = int(
    input("\nDigite o código do produto que deseja buscar: ")
)
# Inicialmente, nenhum produto foi encontrado.
produto_encontrado = None

# Percorre a lista comparando o código de cada produto
# com o código informado pelo usuário.
for produto in produtos:

    if produto.codigo == codigo_busca:
        produto_encontrado = produto

if produto_encontrado is not None:

    print("\nProduto encontrado:")
    print(produto_encontrado.nome)
    print(f"Preço: R$ {produto_encontrado.preco:.2f}")

else:

    print("\nProduto não encontrado.")

# max() procura o maior elemento.
# O parâmetro key informa que a comparação deve ser feita
# utilizando o atributo preco de cada objeto Produto.
# Identifica o produto mais caro
produto_mais_caro = max(
    produtos,
    key=lambda produto: produto.preco
)

print("\nProduto mais caro:")
print(produto_mais_caro.nome)
print(f"Preço: R$ {produto_mais_caro.preco:.2f}")
