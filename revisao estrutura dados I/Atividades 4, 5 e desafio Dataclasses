#Sistema com Menu, que executa até o usuário escolher sair
from dataclasses import dataclass

# Cria a estrutura Produto
@dataclass
class Produto:
    codigo: int
    nome: str
    preco: float
    quantidade: int

# Lista que armazenará os produtos cadastrados
produtos = []

# Mantém o sistema funcionando até o usuário escolher sair
while True:

    print("\n===== SISTEMA DE ESTOQUE =====")
    print("1 - Cadastrar produto")
    print("2 - Listar produtos")
    print("3 - Buscar produto")
    print("4 - Valor total do estoque")
    print("5 - Produto mais caro")
    print("0 - Sair")

    opcao = int(input("\nEscolha: "))

    # 1 - Cadastrar produto
    if opcao == 1:

        print("\n--- CADASTRO DE PRODUTO ---")

        codigo = int(input("Código: "))
        nome = input("Nome: ")
        preco = float(input("Preço: "))
        quantidade = int(input("Quantidade: "))

        # Cria um objeto Produto
        produto = Produto(codigo, nome, preco, quantidade)

        # Adiciona o produto na lista
        produtos.append(produto)

        print("Produto cadastrado com sucesso!")

    # 2 - Listar produtos
    elif opcao == 2:

        print("\n--- PRODUTOS CADASTRADOS ---")

        if len(produtos) == 0:
            print("Nenhum produto cadastrado.")

        else:
            for produto in produtos:
                print(
                    f"Código: {produto.codigo} | "
                    f"Nome: {produto.nome} | "
                    f"Preço: R$ {produto.preco:.2f} | "
                    f"Quantidade: {produto.quantidade}"
                )

    # 3 - Buscar produto pelo código
    elif opcao == 3:

        print("\n--- BUSCAR PRODUTO ---")
        codigo_busca = int(input("Digite o código do produto: "))
        produto_encontrado = None
        for produto in produtos:

            if produto.codigo == codigo_busca:
                produto_encontrado = produto

        if produto_encontrado is not None:
            print("Produto encontrado:")
            print("Código:", produto_encontrado.codigo)
            print("Nome:", produto_encontrado.nome)
            print(f"Preço: R$ {produto_encontrado.preco:.2f}")
            print("Quantidade:", produto_encontrado.quantidade)

        else:
            print("Produto não encontrado.")

    # 4 - Calcular o valor total do estoque
    elif opcao == 4:

        print("\n--- VALOR TOTAL DO ESTOQUE ---")
        valor_total = 0

        for produto in produtos:

            valor_produto = produto.preco * produto.quantidade
            valor_total = valor_total + valor_produto

        print(f"Valor total do estoque: R$ {valor_total:.2f}")

    # 5 - Produto com maior preço
    elif opcao == 5:

        print("\n--- PRODUTO MAIS CARO ---")

        if len(produtos) == 0:
            print("Nenhum produto cadastrado.")

        else:

            produto_mais_caro = produtos[0]
            for produto in produtos:

                if produto.preco > produto_mais_caro.preco:
                    produto_mais_caro = produto

            print("Código:", produto_mais_caro.codigo)
            print("Nome:", produto_mais_caro.nome)
            print(f"Preço: R$ {produto_mais_caro.preco:.2f}")

    # 0 - Encerrar o sistema
    elif opcao == 0:

        print("\nSistema encerrado.")
        break

    # Caso seja digitada uma opção inexistente
    else:
        print("\nOpção inválida.")
#O menu funciona dentro de um while True e cada opção é tratada com if e elif. O cadastro cria um objeto Produto e adiciona à lista com append().
#Para listar, buscar, calcular o estoque e encontrar o produto mais caro, percorro a lista com for.
#O valor total é calculado multiplicando preço pela quantidade de cada produto e acumulando os resultados.
